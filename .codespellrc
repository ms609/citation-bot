[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# Tests and constants contain deliberate malformed strings used by parser and normalization fixtures.
skip = .git*,*.svg,locale,vendor,*.lock,*.css,*.min.*,.codespellrc,./tests/phpunit,./src/includes/constants/null_good_doi.php,./src/includes/constants/translations.php
check-hidden = true
ignore-regex = \b(Fro|Ownes|Requestor|forIn|afterAll|File::WRONLY)\b|/sombody/
# Keep intentional HTTP/query/hostname/regex fragments and existing source identifiers.
# dne == do-not-exists
# defaultY == javascript variable name (cf. defaultX)
ignore-words-list = 2st,ans,defaultY,dne,doubleclick,dum,independ,ist,nd,ned
