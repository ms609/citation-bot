<?php
declare(strict_types=1);
if (get_included_files()[0] === __FILE__) {
    exit(0); // Only need this code if web-server does not block this file
}

/** Suppress all errors to avoid accidentally printing something of value */
if (!getenv('PHP_OAUTH_CONSUMER_TOKEN')) {
    try {
        // Public web configuration. PUBLIC_BASE_URL may include a deployment path, but no query or fragment.
        // ALLOWED_HOSTS contains exact Host header values (with ports when used), never URLs or wildcards.
        // ALLOWED_ORIGINS contains CORS origins without paths. A left-most subdomain wildcard is supported.
        if (!getenv('PUBLIC_BASE_URL')) {
            @putenv('PUBLIC_BASE_URL=https://citations.toolforge.org');
        }
        if (!getenv('ALLOWED_HOSTS')) {
            @putenv('ALLOWED_HOSTS=citations.toolforge.org');
        }
        if (!getenv('ALLOWED_ORIGINS')) {
            @putenv('ALLOWED_ORIGINS=https://citations.toolforge.org,https://mdwiki.org,https://*.wikipedia.org');
        }
        // Bot OAuth authentication - this so that the bot can login and do things such as edit pages as itself.
        // These are needed even when running on the command line
        // https://www.mediawiki.org/wiki/OAuth/Owner-only_consumers#OAuth_1
        // OAuth 1 is what we use.  That is why there are four variables.
        @putenv('PHP_OAUTH_CONSUMER_TOKEN=xxxxx');
        @putenv('PHP_OAUTH_CONSUMER_SECRET=xxxxx');
        @putenv('PHP_OAUTH_ACCESS_TOKEN=xxxxx');
        @putenv('PHP_OAUTH_ACCESS_SECRET=xxxxx');
        // OAuth authentication as Wikipedia user - these are so that the bot can verify that a user has authorized an "Access Grant".
        // This can also can be used to actually edit using the users account.
        // https://www.mediawiki.org/wiki/OAuth/For_Developers (use OAuth version 1)
        // These are not needed when running on the command line
        @putenv('PHP_WP_OAUTH_CONSUMER=xxxxx');
        @putenv('PHP_WP_OAUTH_SECRET=xxxxx');
         // AdsAbs key  -  https://ui.adsabs.harvard.edu/help/api/
        @putenv('PHP_ADSABSAPIKEY=xxxxx');
        // Change this line if you wish the bot, when limit of AdsAbs API calls reached, to sleep until the limit resets;
        // in this case the value of PHP_ADSABSAPILIMITACTION, i.e. the limit action should be "sleep" (without quotes);
        // available actions are: sleep, exit, ignore. ignore is the default if not set.
        @putenv('PHP_ADSABSAPILIMITACTION=ignore');
        // Doing lots of requests to semanticscholar.org without a key gets you blocked
        @putenv('PHP_S2APIKEY=xxxxx');
        // API key and email address for *nlm.nih.gov, can be obtained at https://account.ncbi.nlm.nih.gov/settings/
        @putenv('NLM_APIKEY=xxxxx');
        @putenv('NLM_EMAIL=xxxxx');
        // Optional big-run admission tuning. Normally leave these unset to use reviewed defaults.
        // Set only after measuring interactive latency, CPU/memory pressure, and deferral reasons.
        // @putenv('CITATION_BOT_BIG_RUN_MAX_TOTAL=10');
        // @putenv('CITATION_BOT_BIG_RUN_MAX_DISCOVERY_PROBES=4');
        // Keep web worker count greater than max total + discovery probes.
        // @putenv('CITATION_BOT_BIG_RUN_MAX_LARGE=4');
        // @putenv('CITATION_BOT_BIG_RUN_TOKEN_CAPACITY=400');
        // @putenv('CITATION_BOT_BIG_RUN_TOKEN_REFILL_PER_SECOND=4.0');
        // @putenv('CITATION_BOT_BIG_RUN_STALE_TIMEOUT_SECONDS=900');
        // Heartbeat is additionally capped to at most one-third of the stale timeout.
        // @putenv('CITATION_BOT_BIG_RUN_HEARTBEAT_INTERVAL_SECONDS=30');
        // @putenv('CITATION_BOT_BIG_RUN_POOL_RETRY_SECONDS=30');
        // 256-bit token used by gitpull.php to deploy the latest code from GitHub to Toolforge.
        // Generate once with:
        // php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
        //
        // Interactive use: save the "deploy" account and token in the
        // password manager for https://citations.toolforge.org/gitpull.php;
        // Safari Password AutoFill can then populate the deployment form.
        //
        // Automation: POST the same token in the X-Deploy-Token request header.
        // Query-string credentials are never accepted.
        // A missing, blank, or non-64-hex-character token fails closed.
        @putenv('DEPLOY_TOKEN=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef');
    } catch (Throwable) {
        echo 'Error in env.php';
    }
}
